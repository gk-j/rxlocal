# cp .env.example .env
# MongoDB Community Edition, self-hosted on this machine.
RXLOCAL_MONGO_URI=mongodb://localhost:27017/rxlocal
RXLOCAL_MONGO_DB=rxlocal

RXLOCAL_MONGO_TIMEOUT_MS=5000

# Optional second URI, tried only if the one above does not answer.
RXLOCAL_MONGO_FALLBACK_URI=

RXLOCAL_OPENSHELL_URL=
